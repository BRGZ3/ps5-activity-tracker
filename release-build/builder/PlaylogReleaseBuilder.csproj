<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="$(LibProsperoPkgDir)/src/LibProsperoPkg/LibProsperoPkg.csproj"
      Condition="Exists('$(LibProsperoPkgDir)/src/LibProsperoPkg/LibProsperoPkg.csproj')" />
    <Reference Include="LibProsperoPkg"
      Condition="!Exists('$(LibProsperoPkgDir)/src/LibProsperoPkg/LibProsperoPkg.csproj')">
      <HintPath>$(LibProsperoPkgDir)/LibProsperoPkg.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
